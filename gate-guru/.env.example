# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed to run `npm run seed` locally. Never expose this in Vercel's public env or client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL used for canonical links, Open Graph and sitemap.xml (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://gateguru.example.com
